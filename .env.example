# 天猫登录态文件路径
STATE_FILE=state.json

# 代理配置（可选，不需要就留空或注释）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 并发数（建议2-3，5个容易风控+内存爆）
MAX_CONCURRENT=2

# 错峰启动间隔（秒），避免同时请求被封
STAGGER_SECONDS=45

# 单个爬虫超时（秒），默认2小时
SCRAPE_TIMEOUT=7200

# 单个清洗超时（秒）
CLEAN_TIMEOUT=600

# 失败重试次数
RETRY_TIMES=1
